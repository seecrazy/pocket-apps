default_platform(:ios)

lane :sologuard_beta do
  build_and_upload(scheme: "SoloGuard", bundle_id: "com.pocketapps.sologuard")
end

lane :sologuard_release do
  build_and_submit(scheme: "SoloGuard", bundle_id: "com.pocketapps.sologuard")
end

