private_lane :build_and_upload do |options|
  setup_ci
  sync_profiles(bundle_id: options[:bundle_id])
  build_app(
    scheme: options[:scheme],
    export_method: "app-store"
  )
  upload_to_testflight(skip_waiting_for_build_processing: false)
end

private_lane :build_and_submit do |options|
  setup_ci
  sync_profiles(bundle_id: options[:bundle_id])
  build_app(
    scheme: options[:scheme],
    export_method: "app-store"
  )
  upload_to_testflight(skip_waiting_for_build_processing: true)
  deliver(
    app_identifier: options[:bundle_id],
    metadata_path: "fastlane/metadata/#{options[:bundle_id]}",
    screenshots_path: nil,
    automatic_release: false,
    skip_screenshots: true,
    force: true
  )
end

def sync_profiles(bundle_id:)
  match(
    type: "appstore",
    app_identifier: bundle_id,
    readonly: true
  )
end
